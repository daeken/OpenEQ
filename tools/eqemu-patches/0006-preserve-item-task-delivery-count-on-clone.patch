From b4201d7aa0d1dd0c66dd1676327a25a25cae5b39 Mon Sep 17 00:00:00 2001
From: Sera Brocious <sera.brocious@gmail.com>
Date: Wed, 30 Sep 2026 14:07:30 -0500
Subject: [PATCH] Preserve task-delivery accounting when cloning items

Carry the delivery counter through the copy constructor so copies retain the same remaining-item result. Cover direct copies, Clone, recursive bag and augment copies, inventory insertion, and existing identity and deep-copy semantics in the utility suite.
---
 common/item_instance.cpp   |   1 +
 tests/CMakeLists.txt       |   1 +
 tests/item_instance_test.h | 202 +++++++++++++++++++++++++++++++++++++
 tests/main.cpp             |   2 +
 4 files changed, 206 insertions(+)
 create mode 100644 tests/item_instance_test.h

diff --git a/common/item_instance.cpp b/common/item_instance.cpp
index 39271ba8e..37167b099 100644
--- a/common/item_instance.cpp
+++ b/common/item_instance.cpp
@@ -121,6 +121,7 @@ EQ::ItemInstance::ItemInstance(const ItemInstance& copy)
 	m_currentslot   = copy.m_currentslot;
 	m_attuned       = copy.m_attuned;
 	m_merchantcount = copy.m_merchantcount;
+	m_task_delivered_count = copy.m_task_delivered_count;
 
 	// Copy container contents
 	for (auto it = copy.m_contents.begin(); it != copy.m_contents.end(); ++it) {
