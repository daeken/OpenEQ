From 18987a397be48c79143b16497f6dea948c46c609 Mon Sep 17 00:00:00 2001
From: Sera Brocious <sera.brocious@gmail.com>
Date: Wed, 30 Sep 2026 11:53:03 -0500
Subject: [PATCH] Preserve full class and skill identities in maximum-level
 cache

The class_id * 1000000 + skill_id cache key was narrowed to uint8_t,
merging classes four apart and some adjacent-class skill pairs. With
different maximum levels, GetSkillCap could skip its own final row and
return an empty cap. Retain the full key with uint32_t.

Add an isolated actual-source regression that substitutes only repository
query rows, with no database connection or server configuration. Eight
cases cover collisions, cap lookup, absent pairs, all 1,248 supported
identities, normal behavior, rule ceiling and invalid-row filtering.

On the pinned base, five cases fail and 992/1,248 exhaustive lookups return
wrong maxima and caps. With this change all eight cases pass, including
zero exhaustive mismatches. The standalone CMake target also passes in a
disposable build using the matching common archive and dependencies.
---
 common/skill_caps.cpp           |   2 +-
 tests/CMakeLists.txt            |   7 ++
 tests/skill_caps_cache_test.cpp | 188 ++++++++++++++++++++++++++++++++
 3 files changed, 196 insertions(+), 1 deletion(-)
 create mode 100644 tests/skill_caps_cache_test.cpp

diff --git a/common/skill_caps.cpp b/common/skill_caps.cpp
index 28cfe53ea..a3b3ede15 100644
--- a/common/skill_caps.cpp
+++ b/common/skill_caps.cpp
@@ -20,7 +20,7 @@
 #include "common/timer.h"
 
 // cache the skill cap max level in the database
-std::map<uint8_t, int32_t> skill_max_level = {};
+std::map<uint32_t, int32_t> skill_max_level = {};
 
 uint8 skill_cap_max_level = (
 	RuleI(Character, SkillCapMaxLevel) > 0 ?
diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index 346128d60..40224dbed 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -48,3 +48,10 @@ endif()
 
 set(EXECUTABLE_OUTPUT_PATH ${PROJECT_BINARY_DIR}/bin)
 set_property(TARGET tests PROPERTY FOLDER executables/tests)
+
+# Isolated actual-source regression. The fixture substitutes only repository
+# query rows; no server configuration or database connection is required.
+add_executable(skill_caps_cache_tests skill_caps_cache_test.cpp)
+target_include_directories(skill_caps_cache_tests PRIVATE ..)
+target_link_libraries(skill_caps_cache_tests $<TARGET_PROPERTY:tests,LINK_LIBRARIES>)
+set_property(TARGET skill_caps_cache_tests PROPERTY FOLDER executables/tests)
diff --git a/tests/skill_caps_cache_test.cpp b/tests/skill_caps_cache_test.cpp
new file mode 100644
index 000000000..0e4cc5721
--- /dev/null
+++ b/tests/skill_caps_cache_test.cpp
@@ -0,0 +1,188 @@
