 #include <vector>
 
 class InventoryProfileTest : public Test::Suite {
@@ -36,6 +37,10 @@ public:
 		TEST_ADD(InventoryProfileTest::CursorPutNullRemovesOnlyHead);
 		TEST_ADD(InventoryProfileTest::CursorPutOnEmptyQueue);
 		TEST_ADD(InventoryProfileTest::NonCursorPutPreservesCursor);
+		TEST_ADD(InventoryProfileTest::PoppedBandolierRemainderPreservesTails);
+		TEST_ADD(InventoryProfileTest::PoppedWorldExchangePreservesTails);
+		TEST_ADD(InventoryProfileTest::PoppedOnlyHeadRestores);
+		TEST_ADD(InventoryProfileTest::PoppedNonCursorItemRestores);
 	}
 
 private:
@@ -291,4 +296,109 @@ private:
 		TEST_ASSERT(inventory.GetItem(slot) == nullptr);
 		TEST_ASSERT(Cursor(inventory) == cursor);
 	}
+
+	void PoppedBandolierRemainderPreservesTails()
+	{
+		auto stack_data = Item(100, true);
+		auto tail_data = Item(200);
+		EQ::ItemInstance stack(&stack_data, 5);
+		EQ::ItemInstance tail(&tail_data, 1);
+		EQ::InventoryProfile inventory;
+		inventory.SetInventoryVersion(EQ::versions::ClientVersion::RoF2);
+		inventory.PushCursor(stack);
+		inventory.PushCursor(tail);
+		inventory.PushCursor(tail);
+		const auto before = Cursor(inventory);
+		std::unique_ptr<EQ::ItemInstance> popped(inventory.PopItem(EQ::invslot::slotCursor));
+		popped->SetCharges(4);
+		// SetBandolier restores the remainder, then equips one from its temporary item.
+		inventory.PushCursorFront(*popped);
+		popped->SetCharges(1);
+		inventory.PutItem(EQ::invslot::slotAmmo, *popped);
+		const auto after = Cursor(inventory);
+		TEST_ASSERT(after.size() == before.size());
+		if (after.size() != before.size()) { return; }
+		TEST_ASSERT(after[0] != popped.get());
+		TEST_ASSERT(after[0]->GetSerialNumber() == popped->GetSerialNumber());
+		TEST_ASSERT(after[0]->GetCharges() == 4);
+		TEST_ASSERT(after[1] == before[1]);
+		TEST_ASSERT(after[2] == before[2]);
+		TEST_ASSERT(inventory.GetItem(EQ::invslot::slotAmmo)->GetCharges() == 1);
+	}
+
+	void PoppedWorldExchangePreservesTails()
+	{
+		auto old_data = Item(100);
+		auto bag_data = Item(200);
+		bag_data.ItemClass = EQ::item::ItemClassBag;
+		bag_data.BagSlots = 10;
+		auto child_data = Item(300, true);
+		EQ::ItemInstance old_head(&old_data, 1);
+		EQ::ItemInstance bag(&bag_data, 1);
+		EQ::ItemInstance child(&child_data, 6);
+		bag.PutItem(2, child);
+		bag.PutItem(7, child);
+		EQ::ItemInstance world_container(&bag_data, 1);
+		world_container.PutItem(3, bag);
+		EQ::InventoryProfile inventory;
+		inventory.SetInventoryVersion(EQ::versions::ClientVersion::RoF2);
+		inventory.PushCursor(old_head);
+		inventory.PushCursor(bag);
+		inventory.PushCursor(old_head);
+		const auto before = Cursor(inventory);
+		const auto* tail_child = before[1]->GetItem(7);
+		std::unique_ptr<EQ::ItemInstance> world_item(world_container.PopItem(3));
+		std::unique_ptr<EQ::ItemInstance> popped(inventory.PopItem(EQ::invslot::slotCursor));
+		// Object::PutItem clones through its underlying ItemInstance container.
+		world_container.PutItem(3, *popped);
+		inventory.PushCursorFront(*world_item);
+		const auto after = Cursor(inventory);
+		TEST_ASSERT(after.size() == before.size());
+		if (after.size() != before.size()) { return; }
+		TEST_ASSERT(after[0]->GetSerialNumber() == world_item->GetSerialNumber());
+		TEST_ASSERT(after[0]->GetItem(0) == nullptr);
+		TEST_ASSERT(after[0]->GetItem(2) != nullptr);
+		TEST_ASSERT(after[0]->GetItem(7) != nullptr);
+		if (!after[0]->GetItem(2) || !after[0]->GetItem(7)) { return; }
+		TEST_ASSERT(after[0]->GetItem(2)->GetCharges() == 6);
+		TEST_ASSERT(after[0]->GetItem(7)->GetSerialNumber() == world_item->GetItem(7)->GetSerialNumber());
+		TEST_ASSERT(after[1] == before[1]);
+		TEST_ASSERT(after[2] == before[2]);
+		TEST_ASSERT(after[1]->GetItem(7) == tail_child);
+		TEST_ASSERT(world_container.GetItem(3)->GetSerialNumber() == popped->GetSerialNumber());
+	}
+
+	void PoppedOnlyHeadRestores()
+	{
+		auto data = Item(100, true);
+		EQ::ItemInstance item(&data, 5);
+		EQ::InventoryProfile inventory;
+		inventory.SetInventoryVersion(EQ::versions::ClientVersion::RoF2);
+		inventory.PushCursor(item);
+		std::unique_ptr<EQ::ItemInstance> popped(inventory.PopItem(EQ::invslot::slotCursor));
+		TEST_ASSERT(inventory.CursorEmpty());
+		inventory.PushCursorFront(*popped);
+		TEST_ASSERT(inventory.CursorSize() == 1);
+		TEST_ASSERT(inventory.GetCursorItem() != popped.get());
+		TEST_ASSERT(inventory.GetCursorItem()->GetSerialNumber() == popped->GetSerialNumber());
+		TEST_ASSERT(inventory.GetCursorItem()->GetCharges() == 5);
+	}
+
+	void PoppedNonCursorItemRestores()
+	{
+		auto data = Item(100, true);
+		EQ::ItemInstance item(&data, 5);
+		EQ::InventoryProfile inventory;
+		inventory.SetInventoryVersion(EQ::versions::ClientVersion::RoF2);
+		inventory.PushCursor(item);
+		inventory.PushCursor(item);
+		const auto cursor = Cursor(inventory);
+		inventory.PutItem(EQ::invslot::GENERAL_BEGIN, item);
+		std::unique_ptr<EQ::ItemInstance> popped(inventory.PopItem(EQ::invslot::GENERAL_BEGIN));
+		popped->SetCharges(4);
+		inventory.PutItem(EQ::invslot::GENERAL_BEGIN, *popped);
+		popped->SetCharges(1);
+		TEST_ASSERT(inventory.GetItem(EQ::invslot::GENERAL_BEGIN)->GetCharges() == 4);
+		TEST_ASSERT(Cursor(inventory) == cursor);
+	}
 };
