From 02ad89a6badc90fab1b7a3c14d2cb717b7355c46 Mon Sep 17 00:00:00 2001
From: Sera Brocious <sera.brocious@gmail.com>
Date: Tue, 29 Sep 2026 13:05:58 -0500
Subject: [PATCH] Preserve cursor tails when restoring an already-popped head

Add an explicit clone/prepend operation and use it for world-container exchange and stacked bandolier remainder restoration. PutItem retains its replacement semantics.

Exercise the real InventoryProfile and ItemInstance restoration sequences, including tail order, sparse bag contents, independent stack charges, empty queues and ordinary slots. The former PopItem/PutItem sequences fail 2 of 93 utility tests; the corrected operations pass all 93. Modified zone inventory source also passes syntax checking.
---
 common/inventory_profile.cpp   |   7 +++
 common/inventory_profile.h     |   4 ++
 tests/inventory_profile_test.h | 110 +++++++++++++++++++++++++++++++++
 zone/inventory.cpp             |  14 ++++-
 4 files changed, 133 insertions(+), 2 deletions(-)

diff --git a/common/inventory_profile.cpp b/common/inventory_profile.cpp
index b7b28887f..5fc13d6d5 100644
--- a/common/inventory_profile.cpp
+++ b/common/inventory_profile.cpp
@@ -261,6 +261,13 @@ int16 EQ::InventoryProfile::PushCursor(const ItemInstance &inst) {
 	return invslot::slotCursor;
 }
 
+int16 EQ::InventoryProfile::PushCursorFront(const ItemInstance &inst) {
+	auto restored = inst.Clone();
+	restored->SetEvolveEquipped(false);
+	m_cursor.push_front(restored);
+	return invslot::slotCursor;
+}
+
 EQ::ItemInstance* EQ::InventoryProfile::GetCursorItem() {
 	return m_cursor.peek_front();
 }
diff --git a/common/inventory_profile.h b/common/inventory_profile.h
index 72aa803ae..52f0f120d 100644
--- a/common/inventory_profile.h
+++ b/common/inventory_profile.h
@@ -125,6 +125,10 @@ namespace EQ
 		// Add item to cursor queue
 		int16 PushCursor(const ItemInstance& inst);
 
+		// Prepend a clone without replacing any queued item; caller retains ownership.
+		// Use to restore the cursor head after PopItem(slotCursor).
+		int16 PushCursorFront(const ItemInstance& inst);
+
 		// Get cursor item in front of queue
 		ItemInstance* GetCursorItem();
 
diff --git a/tests/inventory_profile_test.h b/tests/inventory_profile_test.h
index f9fc04bfb..369ebed6b 100644
--- a/tests/inventory_profile_test.h
+++ b/tests/inventory_profile_test.h
@@ -20,6 +20,7 @@
 #include "common/inventory_profile.h"
