+						else {
+							m_inv.PutItem(slot, *BandolierItems[BandolierSlot]);
+						}
 						database.SaveInventory(character_id, BandolierItems[BandolierSlot], slot);
 						BandolierItems[BandolierSlot]->SetCharges(1);
 					}
