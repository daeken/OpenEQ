+#pragma once
+
+#include "common/inventory_profile.h"
+#include "cppunit/cpptest.h"
+
+#include <vector>
+
+class InventoryProfileTest : public Test::Suite {
+public:
+	InventoryProfileTest()
+	{
+		TEST_ADD(InventoryProfileTest::PartialCursorStackPreservesTailTrees);
+		TEST_ADD(InventoryProfileTest::PartialCursorStackWithoutTails);
+		TEST_ADD(InventoryProfileTest::ChargedCursorItemPreservesTailsAtZero);
+		TEST_ADD(InventoryProfileTest::ConsumedCursorHeadPromotesOneTail);
+		TEST_ADD(InventoryProfileTest::NonCursorConsumptionPreservesCursor);
+	}
+
+private:
+	void tear_down() override { EQ::InventoryProfile::CleanDirty(); }
+
+	static EQ::ItemData Item(uint32 id, bool stackable = false)
+	{
+		EQ::ItemData item{};
+		item.ID = id;
+		item.ItemClass = EQ::item::ItemClassCommon;
+		item.Stackable = stackable;
+		item.StackSize = stackable ? 20 : 1;
+		return item;
+	}
+
+	static std::vector<EQ::ItemInstance*> Cursor(EQ::InventoryProfile& inventory)
+	{
+		return {inventory.cursor_cbegin(), inventory.cursor_cend()};
+	}
+
+	void PartialCursorStackPreservesTailTrees()
+	{
+		auto stack_data = Item(100, true);
+		auto bag_data = Item(200);
+		bag_data.ItemClass = EQ::item::ItemClassBag;
+		bag_data.BagSlots = 10;
+		auto child_data = Item(300, true);
+		auto tail_data = Item(400);
+		EQ::ItemInstance stack(&stack_data, 5);
+		EQ::ItemInstance bag(&bag_data, 1);
+		EQ::ItemInstance child(&child_data, 7);
+		EQ::ItemInstance tail(&tail_data, 1);
+		bag.PutItem(2, child);
+		bag.PutItem(7, child);
+		EQ::InventoryProfile inventory;
+		inventory.PushCursor(stack);
+		inventory.PushCursor(bag);
+		inventory.PushCursor(tail);
+		const auto before = Cursor(inventory);
+		const auto* child_two = before[1]->GetItem(2);
+		const auto* child_seven = before[1]->GetItem(7);
+		const auto serial = before[0]->GetSerialNumber();
+
+		TEST_ASSERT(!inventory.DeleteItem(EQ::invslot::slotCursor, 2));
+		TEST_ASSERT(Cursor(inventory) == before);
+		TEST_ASSERT(inventory.GetCursorItem()->GetCharges() == 3);
+		TEST_ASSERT(inventory.GetCursorItem()->GetSerialNumber() == serial);
+		// Tail instance and child pointers must survive, not merely equal item IDs.
+		if (Cursor(inventory) != before) { return; }
+		TEST_ASSERT(before[1]->GetItem(2) == child_two);
+		TEST_ASSERT(before[1]->GetItem(7) == child_seven);
+		TEST_ASSERT(before[1]->GetItem(0) == nullptr);
+		TEST_ASSERT(child_two->GetCharges() == 7);
+		TEST_ASSERT(child_seven->GetCharges() == 7);
+		TEST_ASSERT(!inventory.DeleteItem(EQ::invslot::slotCursor, 1));
+		TEST_ASSERT(Cursor(inventory) == before);
+		TEST_ASSERT(inventory.GetCursorItem()->GetCharges() == 2);
+	}
+
+	void PartialCursorStackWithoutTails()
+	{
+		auto data = Item(100, true);
+		EQ::ItemInstance stack(&data, 5);
+		EQ::InventoryProfile inventory;
+		inventory.PushCursor(stack);
+		const auto before = Cursor(inventory);
+		TEST_ASSERT(!inventory.DeleteItem(EQ::invslot::slotCursor, 2));
+		TEST_ASSERT(Cursor(inventory) == before);
+		TEST_ASSERT(inventory.GetCursorItem()->GetCharges() == 3);
+	}
+
+	void ChargedCursorItemPreservesTailsAtZero()
+	{
+		auto charged_data = Item(100);
+		charged_data.MaxCharges = 5;
+		charged_data.Click.Type = EQ::item::ItemEffectClick;
+		auto tail_data = Item(200);
+		EQ::ItemInstance charged(&charged_data, 2);
+		EQ::ItemInstance tail(&tail_data, 1);
+		EQ::InventoryProfile inventory;
+		inventory.PushCursor(charged);
+		inventory.PushCursor(tail);
+		inventory.PushCursor(tail);
+		const auto before = Cursor(inventory);
+		TEST_ASSERT(!inventory.DeleteItem(EQ::invslot::slotCursor, 1));
+		TEST_ASSERT(Cursor(inventory) == before);
+		TEST_ASSERT(inventory.GetCursorItem()->GetCharges() == 1);
+		TEST_ASSERT(!inventory.DeleteItem(EQ::invslot::slotCursor, 1));
+		TEST_ASSERT(Cursor(inventory) == before);
+		TEST_ASSERT(inventory.GetCursorItem()->GetCharges() == 0);
+	}
+
+	void ConsumedCursorHeadPromotesOneTail()
+	{
+		for (int kind = 0; kind < 3; ++kind) {
+			auto head_data = Item(100, kind == 0);
+			if (kind == 1) {
+				head_data.MaxCharges = 1;
+				head_data.Click.Type = EQ::item::ItemEffectExpendable;
+			}
+			auto tail_data = Item(200);
+			EQ::ItemInstance head(&head_data, 1);
+			EQ::ItemInstance tail(&tail_data, 1);
+			EQ::InventoryProfile inventory;
+			inventory.PushCursor(head);
+			inventory.PushCursor(tail);
+			inventory.PushCursor(tail);
+			auto remaining = Cursor(inventory);
+			remaining.erase(remaining.begin());
+			TEST_ASSERT(inventory.DeleteItem(EQ::invslot::slotCursor, kind == 2 ? 0 : 1));
+			TEST_ASSERT(Cursor(inventory) == remaining);
+			TEST_ASSERT(inventory.GetCursorItem() == remaining.front());
+		}
+	}
+
+	void NonCursorConsumptionPreservesCursor()
+	{
+		auto data = Item(100, true);
+		EQ::ItemInstance stack(&data, 5);
+		EQ::InventoryProfile inventory;
+		inventory.SetInventoryVersion(EQ::versions::ClientVersion::RoF2);
+		inventory.PushCursor(stack);
+		inventory.PushCursor(stack);
+		inventory.PutItem(EQ::invslot::GENERAL_BEGIN, stack);
+		const auto cursor = Cursor(inventory);
+		const auto* carried = inventory.GetItem(EQ::invslot::GENERAL_BEGIN);
+		TEST_ASSERT(carried != nullptr);
+		if (!carried) { return; }
+		TEST_ASSERT(!inventory.DeleteItem(EQ::invslot::GENERAL_BEGIN, 2));
+		TEST_ASSERT(inventory.GetItem(EQ::invslot::GENERAL_BEGIN) == carried);
+		TEST_ASSERT(carried->GetCharges() == 3);
+		TEST_ASSERT(Cursor(inventory) == cursor);
+		TEST_ASSERT(inventory.DeleteItem(EQ::invslot::GENERAL_BEGIN, 3));
+		TEST_ASSERT(inventory.GetItem(EQ::invslot::GENERAL_BEGIN) == nullptr);
+		TEST_ASSERT(Cursor(inventory) == cursor);
+	}
+};
