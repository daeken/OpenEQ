From d414cef5fba6b4f3810c2f35e0e60e7fa9e4ba6b Mon Sep 17 00:00:00 2001
From: Sera Brocious <sera.brocious@gmail.com>
Date: Tue, 29 Sep 2026 12:35:24 -0500
Subject: [PATCH] Preserve cursor tails when partially consuming the head

---
 common/inventory_profile.cpp   |  10 +-
 tests/CMakeLists.txt           |   1 +
 tests/inventory_profile_test.h | 170 +++++++++++++++++++++++++++++++++
 tests/main.cpp                 |   4 +-
 4 files changed, 183 insertions(+), 2 deletions(-)
 create mode 100644 tests/inventory_profile_test.h

diff --git a/common/inventory_profile.cpp b/common/inventory_profile.cpp
index 2ec3d6a08..7b1a53a8b 100644
--- a/common/inventory_profile.cpp
+++ b/common/inventory_profile.cpp
@@ -424,7 +424,15 @@ bool EQ::InventoryProfile::DeleteItem(int16 slot_id, int16 quantity) {
 		}
 
 		// Charges still exist, or it is a charged item that is not expendable. Put back into inventory
-		_PutItem(slot_id, item_to_delete);
+		if (slot_id == invslot::slotCursor) {
+			// The head was already popped. Replacing the current cursor item
+			// with _PutItem would discard the next item in the queue.
+			item_to_delete->SetEvolveEquipped(false);
+			m_cursor.push_front(item_to_delete);
+		}
+		else {
+			_PutItem(slot_id, item_to_delete);
+		}
 		return false;
 	}
 
